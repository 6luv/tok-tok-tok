<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- 앱 시작 화면(사용자 요청 2026-11-11): 기기 모드와 관계없이 다크 바탕색(#1B1A18, Assets LaunchBackground)만 보인다.
	     사용자 기기에서 그림이 깨져 보인다는 보고가 있어(원인은 기종별 배치·확대 차이로 추정, 재현 미확인) 그림은 넣지 않고, 이어지는 앱 안 로딩 화면(LaunchSplashView)이
	     화면 너비에 맞춰 벡터로 그린다. 나머지 키는 Xcode가 생성한다. -->
	<!-- 수출 규정(2026-11-16): 앱은 OS가 제공하는 표준 암호화 외에 자체 암호화를 쓰지 않는다(네트워크 통신 없음).
	     이 키가 있으면 빌드를 올릴 때마다 App Store Connect에서 수출 규정 질문을 다시 받지 않는다. -->
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>
	<key>UILaunchScreen</key>
	<dict>
		<key>UIColorName</key>
		<string>LaunchBackground</string>
	</dict>
</dict>
</plist>
